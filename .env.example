# Copy this file to .env.local and fill in values you want active.
# .env.local is git-ignored. Vite exposes only VITE_* prefixed vars to the client.

# Google Analytics 4 - paste the Measurement ID from Admin > Data Streams.
# Leave blank to skip injecting GA.
VITE_GA_MEASUREMENT_ID=

# Plausible Analytics - the domain registered in your Plausible dashboard
# (no protocol, no path). Leave blank to skip Plausible.
VITE_PLAUSIBLE_DOMAIN=

# Optional: self-hosted Plausible script URL.
# Defaults to https://plausible.io/js/script.js when unset.
VITE_PLAUSIBLE_SRC=
